# Copy this file to .env and fill in real values before deploying.
# Never commit .env to source control.

# Secret used by iron-session to encrypt the session cookie (min 32 chars)
SESSION_SECRET=replace-with-a-strong-random-secret-here-min32c

# Shared secret between BFF and Core API for JWT signing/verification (min 32 chars)
CORE_API_JWT_SECRET=replace-with-a-strong-random-secret-here-min32c

# MongoDB URI (override for external MongoDB Atlas, etc.)
# MONGO_URI=mongodb://user:password@host:27017/sustainabuild
