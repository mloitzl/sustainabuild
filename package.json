{
  "name": "sustainabuild",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "test": "turbo run test",
    "test:e2e:web": "pnpm --filter=@sustainabuild/web run test:e2e",
    "ui:guardrails:baseline": "bash scripts/ui-baseline-guardrails.sh",
    "ui:guardrails:strict": "STRICT_RELAY_GUARDRAILS=1 bash scripts/ui-baseline-guardrails.sh"
  },
  "devDependencies": {
    "@sustainabuild/prettier-config": "workspace:*",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "prettier": "@sustainabuild/prettier-config"
}
